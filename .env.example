# =================================================================
# ShetMitra AI - Rural Intelligence Platform Environment Variables
# =================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini 3.8 Flash multimodal & conversational engine).
# In Google AI Studio, this is automatically injected at runtime.
# For local or custom cloud deployments, obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The base URL where this applet/service is hosted.
# Used for self-referential links, webhooks, and API calls.
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Set to "development" or "production"
NODE_ENV="development"

# =================================================================
# Bhashini National Language Infrastructure Configuration
# (Ministry of Electronics and Information Technology - MeitY, India)
# =================================================================

# BHASHINI_USER_ID: Bhashini Udyat Portal Key / User ID
BHASHINI_USER_ID="YOUR_BHASHINI_USER_ID"

# BHASHINI_INFERENCE_KEY: Bhashini Dhruva Inference API Authorization Key
BHASHINI_INFERENCE_KEY="YOUR_BHASHINI_INFERENCE_KEY"

# BHASHINI_API_URL: Bhashini Dhruva pipeline compute endpoint
BHASHINI_API_URL="https://dhruva-api.bhashini.gov.in/services/inference/pipeline"
